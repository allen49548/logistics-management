    "detail_used": "「{item}」取自明细合计行 {cell}（表头「{header}」）",
    "detail_sum_used": "「{item}」由明细行求和 {cell}（无合计行）",
    "label_conflict": "「{item}」命中多个标签：{pairs}，按标签优先级取 {chosen}",
    "strategy_conflict": "「{item}」{preferred}值 {a} 与{other}值 {b} 不一致（差 {diff}），已取{preferred}",
    "overlap_excluded": "「{item}」已含于「{owner}」（经源表净利润校验），不重复计入",
    "overlap_included": "「{item}」未含于「{owner}」，按源表净利润校验结果单独计入",
    "profit_diff": "计算净利润 {calc} 与源表 {src} 差 {diff}，口径需业务确认",
    "profit_match": "计算净利润与源表一致（{calc}）",
    "no_source_profit": "源表无净利润标签，未做校验",
    "cannot_compute": "缺运费或支出科目，净利润无法计算",
    "prev_missing": "{prev_month}月净利润无法计算",
    "incomparable_partial": "{prev_month}月{metric}仅为{month}月的 {pct}，低于 {min_pct} 阈值，视为不完整月份",
    "incomparable_no_prev": "{prev_month}月无数据",
    "ratio_guard": "{prev_month}月净利润为 {prev}，比例不具可比性",
    "flat": "持平",
    "up": "上升",
    "down": "下降"
  },
  "status": {
    "ok": "完整",
    "no_data": "无{month}月数据",
    "cannot_compute": "无法计算",
    "differs": "与源表有差异",
    "noted": "有备注",
