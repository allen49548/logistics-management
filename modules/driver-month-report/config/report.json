{
  "schema_version": 1,
  "report": {
    "title_template": "{year}年{month}月汇总",
    "current_period": "2026-08",
    "previous_period": "2026-07",
    "comparison_only_previous": true,
    "unit": "元",
    "generated_by": "driver-month-report"
  },
  "source": {
    "driver_dir": "/Users/liaohaocheng/Desktop/WPS/冷链物流/2026年/司机工资",
    "file_patterns": [
      "*2026.xlsx"
    ],
    "exclude_globs": [
      "~$*",
      ".*",
      "*汇总*.xlsx",
      "*.tmp.xlsx"
    ],
    "driver_name_regex": "^(?P<name>.+?)2026$",
    "sheet_name_template": "{year}.{month}",
    "driver_aliases": {
      "辛荣超": [
        "幸荣超"
      ]
    },
    "driver_order": []
  },
  "output": {
    "dir": "",
    "filename_template": "{title}.xlsx",
    "overwrite": {
      "enabled": true,
      "mode": "recycle",
      "recycle_dir": ".recycle",
      "match_globs": [
        "*{month}月汇总*.xlsx",
        "{title}.xlsx",
        "*{month}月汇总*.xls"
      ],
      "report_deleted": true
    },
    "sheets": {
      "summary": "{month}月汇总",
      "detail": "项目明细",
      "spec": "口径与校验"
    }
  },
  "scan": {
    "label": {
      "max_len": 24,
      "strip_parenthetical": true
    },
    "amount": {
      "direction": "right",
      "max_offset": 4,
      "stop_at_known_label": true,
      "parse_text": true,
      "strip_chars": [
        "¥",
        "￥",
        ",",
        "，",
        " ",
        "元",
        "　"
      ],
      "note_max_offset": 3,
      "note_max_len": 24
    }
  },
  "detail": {
    "enabled": true,
    "header_rows": [
      1
    ],
    "total_row_keywords": [
      "合计",
      "总计",
      "小计"
    ],
    "fallback_to_sum": true,
    "stop_at_subtotal": true
  },
  "resolution": {
    "default_order": [
      "label",
      "detail",
      "derive"
    ],
    "strategy_titles": {
      "label": "汇总标签",
      "detail": "明细合计",
      "derive": "源表净利倒算"
    },
    "conflict_flag": true,
    "agreement_tolerance_pct": 0.005
  },
  "overlap": {
    "enabled": true,
    "decide_by": "source_net_profit",
    "fallback": "exclude"
  },
  "calculation": {
    "net_profit_expression": "income - wage - expense",
    "variables": {
      "income": "income",
      "wage": "wage",
      "expense": "expense"
    },
    "source_profit_item": "source_net_profit",
    "check_tolerance": 0.01,
    "round_digits": 2
  },
  "mom": {
    "enabled": true,
    "value_key": "net_profit",
    "delta_expression": "current - previous",
    "ratio_expression": "(current - previous) / previous",
    "decimals": 2
  },
  "comparability": {
    "enabled": true,
    "reference_item": "income_freight",
    "secondary_item": "wage_total",
    "min_ratio": 0.6,
    "require_both_net": true
  },
  "highlight": {
    "increase_color": "C00000",
    "decrease_color": "008000",
    "flat_color": "808080",
    "fill": "FFF2CC",
    "banner_fill": "FCE4D6"
  },
  "number_formats": {
    "money": "¥#,##0.00",
    "percent": "0.00%",
    "int": "0"
  },
  "columns": [
    {
      "key": "index",
      "title": "序号",
      "width": 6,
      "align": "center"
    },
    {
      "key": "driver",
      "title": "司机",
      "width": 11
    },
    {
      "key": "income",
      "title": "运费收入",
      "width": 14,
      "format": "money"
    },
    {
      "key": "wage",
      "title": "工资",
      "width": 13,
      "format": "money"
    },
    {
      "key": "expense",
      "title": "其他支出合计",
      "width": 15,
      "format": "money"
    },
    {
      "key": "net_profit",
      "title": "净利润（{month}月）",
      "width": 16,
      "format": "money",
      "bold": true
    },
    {
      "key": "prev_net_profit",
      "title": "净利润（{prev_month}月）",
      "width": 16,
      "format": "money"
    },
    {
      "key": "delta",
      "title": "环比增减额",
      "width": 15,
      "format": "money",
      "highlight": "delta",
      "bold": true
    },
    {
      "key": "ratio",
      "title": "环比增减比例",
      "width": 15,
      "format": "percent",
      "highlight": "ratio",
      "bold": true,
      "databar": true
    },
    {
      "key": "trend",
      "title": "趋势",
      "width": 9,
      "align": "center",
      "highlight": "trend"
    },
    {
      "key": "status",
      "title": "数据状态",
      "width": 19,
      "align": "center"
    },
    {
      "key": "note",
      "title": "异常 / 缺失说明（含数据来源）",
      "width": 62,
      "wrap": true
    }
  ],
  "kpi": [
    {
      "key": "net_current",
      "title": "{month}月净利润合计",
      "format": "money"
    },
    {
      "key": "net_previous",
      "title": "{prev_month}月净利润合计",
      "format": "money"
    },
    {
      "key": "delta",
      "title": "环比增减额（可比口径）",
      "format": "money",
      "highlight": true
    },
    {
      "key": "ratio",
      "title": "环比增减比例（可比口径）",
      "format": "percent",
      "highlight": true
    },
    {
      "key": "comparable",
      "title": "可比司机数",
      "format": "int"
    },
    {
      "key": "issues",
      "title": "异常 / 缺失项",
      "format": "int"
    }
  ],
  "messages": {
    "subtitle": "期间：{year}年{month}月　｜　环比对象：{prev_year}年{prev_month}月（仅此一个月）　｜　单位：{unit}　｜　口径：净利润 = 运费收入 − 工资 − 其他支出；环比按可比司机口径　｜　生成时间：{generated_at}",
    "banner": "环比结论：{month}月净利润合计 {cur}，较 {prev_month}月 {prev} {trend_word} {abs_delta}（{ratio}）；可比司机 {comparable} 人（上升 {up} 人 / 下降 {down} 人 / 不可比 {incomparable} 人）。",
    "banner_no_prev": "环比结论：{prev_month}月可用数据不足，无法形成有效环比；下方已逐人列出缺失原因，补录后重跑即可。",
    "missing_sheet": "源文件无「{sheet}」工作表，{month}月无法取数",
    "missing_file": "未找到该司机对应文件",
    "missing_item": "未识别「{item}」：表内无匹配标签（候选：{aliases}）",
